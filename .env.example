# ========================================================
# XSPACEWEB Environment Variables Example
# Copy this file to .env.local and populate with your credentials.
# ========================================================

# Base application URL (Local or Production)
NEXTAUTH_URL="http://localhost:3000"

# Neon PostgreSQL Database Connection String
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth Configuration
# Generate a secret using: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your-generated-auth-secret"

# Google OAuth (for CRM admin login)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Authorized Admin Email (only this Google account can access CRM)
ADMIN_EMAIL="admin@yourdomain.com"

# Google Maps API Key (for contact page map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudinary (Image & media uploads for News, Events, Gallery, Media Logos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Resend Email Integration (Newsletter Audience & Broadcast Dispatches)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="XSPACEWEB <news@yourdomain.com>"
# Optional: Pre-configured Resend Audience ID (will auto-discover or create if omitted)
# RESEND_AUDIENCE_ID="your-resend-audience-id"
